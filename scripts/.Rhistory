# Select numeric variables for scaling
num_vars <- df_2019[, c(
"Life evaluation (3-year average)",
"Explained by: Log GDP per capita",
"Explained by: Social support",
"Explained by: Healthy life expectancy",
"Explained by: Freedom to make life choices",
"Explained by: Generosity",
"Explained by: Perceptions of corruption",
"Share.of.people.who.attend.religious.services.frequently",
"SafetyAfterDark",
"hrs worked",
"AverageVacationDays_MinimumTotalPaidLeave_days_YearFree",
"AverageVacationDays_LegallyRequiredMinimumPaidVacationDaysPerYear_days_YearFree",
"AverageVacationDays_PaidPublicHolidays_days_YearFree",
"AverageRetirementAge",
"SunshineHours",
"HomicideRate"
)]
#print (df_2019)
# Scale numeric variables (mean=0, sd=1)
scaled <- as.data.frame(scale(num_vars))
# Add back Country and Year
scaled$Country <- as.character(df_2019$Country)
scaled$Year <- as.integer(df_2019$Year)
#now run ML section:
#see whats missing - lots
missing_summary <- df_2019 %>%
summarise(
across(
everything(),
~ sum(is.na(.))
)
) %>%
pivot_longer(
cols = everything(),
names_to = "Variable",
values_to = "Missing"
) %>%
mutate(
Total = nrow(df_2019),
MissingPercent = (Missing / Total) * 100
) %>%
arrange(desc(MissingPercent))
print(missing_summary)
#Keep only added factors with data for at least 50% of observations.
#I end up with only 4 of the 7 new factors i introduced, probably should have checked this first.
new_factor_names <- c(
"Share.of.people.who.attend.religious.services.frequently",
"SafetyAfterDark",
"hrs worked",
"AverageVacationDays_MinimumTotalPaidLeave_days_YearFree",
"AverageVacationDays_LegallyRequiredMinimumPaidVacationDaysPerYear_days_YearFree",
"AverageVacationDays_PaidPublicHolidays_days_YearFree",
"AverageRetirementAge",
"SunshineHours",
"HomicideRate"
)
new_factor_coverage <- missing_summary %>%
filter(Variable %in% new_factor_names) %>%
mutate(CoveragePercent = 100 - MissingPercent) %>%
select(Variable, Total, Missing, MissingPercent, CoveragePercent)
print(new_factor_coverage)
write.csv(new_factor_coverage, "../outputs/new_factor_coverage.csv", row.names = FALSE)
selected_new_factors <- new_factor_coverage %>%
filter(CoveragePercent >= 50) %>%
pull(Variable)
print(selected_new_factors)
base_factor_names <- c(
"Life evaluation (3-year average)",
"Explained by: Log GDP per capita",
"Explained by: Social support",
"Explained by: Healthy life expectancy",
"Explained by: Freedom to make life choices",
"Explained by: Generosity",
"Explained by: Perceptions of corruption"
)
#Both models use the same complete rows, making the performance comparison fair.
#After dropping the factors which didnt have enough data, I am left with around 300 rows as opposed the 1000 or so I had originally.
expanded_data <- df_2019 %>%
select(all_of(c(base_factor_names, selected_new_factors))) %>%
drop_na()
#Use the same rows for the baseline and expanded models.
baseline_data <- expanded_data %>%
select(all_of(base_factor_names))
expanded_scaled <- as.data.frame(scale(expanded_data))
names(expanded_scaled) <- make.names(names(expanded_scaled), unique = TRUE)
baseline_scaled <- as.data.frame(scale(baseline_data))
names(baseline_scaled) <- make.names(names(baseline_scaled), unique = TRUE)
#Remove Life Evaluation
cluster_data_round2 <- expanded_scaled %>%
dplyr::select(-Life.evaluation..3.year.average.)
png("../outputs/elbow_method.png", width = 1200, height = 900, res = 150)
print(fviz_nbclust(cluster_data_round2, kmeans, method = "wss"))
dev.off()
