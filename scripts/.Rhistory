# Average life evaluation by continent.
continent_summary <- dashboard_data %>%
group_by(Continent) %>%
summarise(
Average_Live_Evaluation = mean(`Life evaluation (3-year average)`, na.rm = TRUE),
Countries = n_distinct(Country),
