row.names = FALSE
)
#RF2
run_random_forest <- function(model_data) {
y <- model_data$Life.evaluation..3.year.average.
x <- model_data %>% select(-Life.evaluation..3.year.average.)
set.seed(500)
train_index <- createDataPartition(y, p = 0.8, list = FALSE)
set.seed(500)
model <- randomForest(x = x[train_index, ], y = y[train_index],
ntree = 500, importance = TRUE)
predictions <- predict(model, newdata = x[-train_index, ])
r_value <- cor(predictions, y[-train_index])
data.frame(
RMSE = sqrt(mean((predictions - y[-train_index])^2)),
R = r_value,
R_squared = r_value^2
)
}
baseline_results <- run_random_forest(baseline_scaled)
expanded_results <- run_random_forest(expanded_scaled)
model_comparison <- rbind(
cbind(Model = "Original WHR factors", baseline_results),
cbind(Model = "Original + non-financial factors", expanded_results)
)
print(model_comparison)
write.csv(model_comparison, "../outputs/model_comparison.csv", row.names = FALSE)
model_comparison_long <- model_comparison %>%
pivot_longer(c(RMSE, R, R_squared), names_to = "Metric", values_to = "Value")
ggsave(
"../outputs/model_comparison.png",
ggplot(model_comparison_long, aes(Metric, Value, fill = Model)) +
geom_col(position = "dodge") + theme_minimal() +
labs(title = "Random Forest model comparison",
subtitle = "Higher is better for R and R-squared; lower is better for RMSE",
x = NULL, y = "Value"),
width = 10, height = 7, dpi = 150
)
baseline_model <- randomForest(
x = baseline_scaled %>% select(-Life.evaluation..3.year.average.),
y = baseline_scaled$Life.evaluation..3.year.average.,
ntree = 500,
importance = TRUE
)
png("../outputs/random_forest_importance.png",
width = 3600, height = 900, res = 150)
varImpPlot(baseline_model, type = 1)
dev.off()
#Fit the expanded model again
y_expanded <- expanded_scaled$Life.evaluation..3.year.average.
x_expanded <- expanded_scaled %>% select(-Life.evaluation..3.year.average.)
set.seed(500)
expanded_model <- randomForest(x = x_expanded, y = y_expanded,
ntree = 500, importance = TRUE)
print(importance(expanded_model))
png("../outputs/expanded_random_forest_importance.png",
width = 3600, height = 900, res = 150)
varImpPlot(expanded_model, type = 1)
dev.off()
predictor_names <- names(baseline_data)[-1]
correlation_results <- data.frame()
for (variable in predictor_names) {
test <- cor.test(
baseline_data[[variable]],
baseline_data[["Life evaluation (3-year average)"]],
method = "pearson"
)
correlation_results <- rbind(
correlation_results,
data.frame(
Variable = variable,
Correlation = test$estimate,
P_value = test$p.value
)
)
}
write.csv(correlation_results, "../outputs/correlation_results.csv", row.names = FALSE)
#Scatter plots for the retained non-financial factors.
new_factor_names <- make.names(selected_new_factors, unique = TRUE)
for (variable in new_factor_names) {
p <- ggplot(
expanded_scaled,
aes(x = .data[[variable]], y = Life.evaluation..3.year.average.)
) +
geom_point(alpha = 0.6) +
geom_smooth(method = "lm", se = TRUE) +
labs(
title = paste("Life Evaluation vs", variable),
x = variable,
y = "Life Evaluation"
) +
theme_minimal()
ggsave(
paste0("../outputs/scatter_new_factor_", make.names(variable), ".png"),
plot = p,
width = 10,
height = 7,
dpi = 150
)
}
