print(fviz_nbclust(cluster_data_round2, kmeans, method = "silhouette"))
dev.off()
set.seed(500)
gap <- clusGap(cluster_data_round2, FUN = kmeans, K.max = 10)
png("../outputs/gap_statistic.png", width = 1200, height = 900, res = 150)
print(fviz_gap_stat(gap))
dev.off()
#K-Means
set.seed(500)
km_round2 <- kmeans(
cluster_data_round2,
centers = 3,
nstart = 25
)
#Add descriptive cluster labels to dashboard data after clustering is complete.
cluster_lookup <- df_2019 %>%
select(
Country = `Country name`, ISO3, Year,
all_of(c(base_factor_names, selected_new_factors))
) %>%
drop_na(all_of(c(base_factor_names, selected_new_factors))) %>%
mutate(Cluster = paste("Cluster", km_round2$cluster)) %>%
select(Country, ISO3, Year, Cluster)
dashboard_long <- dashboard_data %>%
left_join(cluster_lookup, by = c("Country", "ISO3", "Year")) %>%
mutate(Cluster = replace_na(Cluster, "Not in clustering sample"))
write.csv(
dashboard_long,
"../outputs/dashboard_long.csv",
row.names = FALSE
)
