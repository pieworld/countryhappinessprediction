origin = "country.name",
destination = "iso3c"
)
#kosovo needs manual matching
df_2019$ISO3[df_2019$Country == "Kosovo"] <- "XKX"
#Add continent based on ISO3 country code
df_2019$Continent <- countrycode(
df_2019$ISO3,
origin = "iso3c",
destination = "continent"
)
#kosovo needs manual matching
df_2019$Continent[df_2019$Country == "Kosovo"] <- "Europe"
#join additional factors
#religion
#check for religion duplicates
religion %>%
count(Code, Year) %>%
filter(n > 1)
#join on code and year
df_2019 <- df_2019 %>%
left_join(
religion,
by = c(
"ISO3" = "Code",
"Year" = "Year"
)
)
#saftey after dark
safteyafterdark <- safteyafterdark %>%
filter(
sex == "Total",
crime == "Total",
drug == "Total"
) %>%
select(
year,
iso3_code,
value
) %>%
mutate(
year = as.integer(year),
value = as.numeric(value)
) %>%
rename(
SafetyAfterDark = value
)
#Join to df_2019
df_2019 <- df_2019 %>%
left_join(
safteyafterdark,
by = c(
"ISO3" = "iso3_code",
"Year" = "year"
)
)
#hoursworked
hrsworked$ISO3 <- countrycode(
hrsworked$ref_area.label,
origin = "country.name",
destination = "iso3c"
)
#kosovo and Naoero needs manual matching
hrsworked$ISO3[hrsworked$ref_area.label == "Kosovo"] <- "XKX"
hrsworked$ISO3[hrsworked$ref_area.label == "Naoero"] <- "NRU"
#Prepare hours worked data
hrsworked <- hrsworked %>%
select(
ISO3,
time,
obs_value
) %>%
mutate(
obs_value = as.numeric(obs_value)
) %>%
group_by(ISO3, time) %>%
summarise(
obs_value = mean(obs_value, na.rm = TRUE),
.groups = "drop"
) %>%
rename(
`hrs worked` = obs_value
)
# Join hours worked to df_2019
df_2019 <- df_2019 %>%
left_join(
hrsworked,
by = c(
"ISO3" = "ISO3",
"Year" = "time"
)
)
#Intentional homicide rate.
#rate per 100,000 population.
homicide <- homicide %>%
filter(
Indicator == "Victims of intentional homicide",
Dimension == "Total",
Category == "Total",
Sex == "Total",
Age == "Total",
.data[["Unit of measurement"]] == "Rate per 100,000 population"
) %>%
select(Iso3_code, Year, VALUE) %>%
rename(HomicideRate = VALUE)
df_2019 <- df_2019 %>%
left_join(
homicide,
by = c("ISO3" = "Iso3_code", "Year" = "Year")
)
#vacation days
vacationdays <- vacationdays %>%
mutate(
ISO3 = countrycode(country, origin = "country.name", destination = "iso3c")
)
df_2019 <- df_2019 %>%
left_join(
vacationdays,
by = c("ISO3" = "ISO3")
)
#Retirement age is available for one recent year only. Treat it as time-invariant
retirementage <- retirementage %>%
mutate(
ISO3 = countrycode(country, origin = "country.name", destination = "iso3c"),
AverageRetirementAge = (RetirementAgeMen + RetirementAgeWomen) / 2
) %>%
select(ISO3, AverageRetirementAge)
df_2019 <- df_2019 %>%
left_join(
retirementage,
by = c("ISO3" = "ISO3")
)
#sunshine hours
sunshinehours <- sunshinehours %>%
group_by(Country) %>%
summarise(
Year = mean(Year, na.rm = TRUE),
.groups = "drop"
)
sunshinehours <- sunshinehours %>%
rename(
SunshineHours = Year
) %>%
mutate(
ISO3 = countrycode(
Country,
origin = "country.name",
destination = "iso3c"
)
)
df_2019 <- df_2019 %>%
left_join(
sunshinehours,
by = c("ISO3" = "ISO3")
)
#cut columns
#Check column names first
print(names(df_2019))
#cut unnessesary columns
df_2019 <- df_2019 %>%
select(
-any_of(c(
"country",
"Entity",
"flagCode",
"Share of people who attend religious services frequently (Annotations)"
))
)
#Data used by the dashboard.
